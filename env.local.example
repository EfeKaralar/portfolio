# Environment Variables for Contact Form
# Copy this using `cp env.local.example .env.local`
# and update it

# Choose ONE of the following email service options:

# Option 1: Resend (Recommended - easiest setup)
# Sign up at https://resend.com
RESEND_API_KEY=re_your_api_key_here
CONTACT_EMAIL=karalar.alpefe@gmail.com

# Option 2: SendGrid
# Sign up at https://sendgrid.com
# SENDGRID_API_KEY=SG.your_api_key_here
# SENDGRID_FROM_EMAIL=noreply@yourdomain.com
# CONTACT_EMAIL=karalar.alpefe@gmail.com

# Option 3: SMTP (Gmail, Outlook, etc.)
# For Gmail: Enable 2FA and create an App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourdomain.com
# CONTACT_EMAIL=karalar.alpefe@gmail.com
